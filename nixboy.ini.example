; Copy to nixboy.ini in a separate Fallout 2 CE test installation.
; Start the local bridge and use the token file it generated in that directory.
[nixboy]
enabled=1
; Default opening shortcut in gameplay/Pip-Boy. Restart game after changing.
; Case-insensitive: Ctrl+A..Z (except H/I/M), Alt+A..Z, A..Z, F1..F12, or none.
; The configured shortcut takes precedence over the game's action for that key.
; Use none to keep only the Pip-Boy nix-boy button. Invalid values disable it.
hotkey=Ctrl+N
; Terminal presentation, reloaded whenever nix-boy opens.
; 0: centered window with the surrounding game UI visible; 1: full game screen.
fullscreen=0
; 1: curved green CRT, soft bloom and phosphor persistence; 0: flat original colors.
retro_terminal=1
; CRT strengths: 0 disables the effect, 100 matches the previous preview's strength.
crt_warp=100
crt_glow=20
; Phosphor fade time to one-tenth intensity, 0..2000 ms; 0 clears immediately.
crt_persistence_ms=120
; nix-boy hub: two skill tracks, two current-skill bands each, five options per level.
; Set to 0 for the original ephemeral shell and explicit legacy bindings.
training=1
port=47821
token_file=nixboy.token

; Legacy free-shell mode only: named results can write listed global indexes.
; No bindings are enabled by default. Choose indexes owned by YOUR mod;
; arbitrary vanilla indexes will change existing quests or character state.
; The starting value is sent to Linux as context key global.<name>.
[bindings]
; challenge_result=YOUR_MOD_GLOBAL_INDEX
; terminal_exit=YOUR_MOD_EXIT_GLOBAL_INDEX
